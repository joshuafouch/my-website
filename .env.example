PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
ADMIN_EMAIL=

# Optional — admin observability (all free APIs; leave blank until ready)
# Create a Vercel token: https://vercel.com/account/tokens
# Enable free Web Analytics + Speed Insights on the project (Hobby is fine).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Only needed for team-owned projects
VERCEL_TEAM_ID=

# Optional — Supabase usage dashboard
# Personal access token with analytics_usage_read + infra_disk_config_read
# Project ref is ONLY the subdomain id (xxxx), not the full https://xxxx.supabase.co URL
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
