PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
ADMIN_EMAIL=

# Optional — admin observability (all free APIs; leave blank until ready)
# Create a Vercel token: https://vercel.com/account/tokens
# Vercel tokens can't be read-only, so limit the damage if one leaks: scope it to the team, give
# it an expiry date, and set it for the Production environment only (preview builds run any
# branch's code).
# Enable free Web Analytics + Speed Insights on the project (Hobby is fine).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Only needed for team-owned projects
VERCEL_TEAM_ID=

# Optional — Supabase usage dashboard
# Scoped personal access token (starts with sbp_fc), limited to this project with ONLY:
#   Usage Analytics: Read  +  Disk Config: Read
# No Database permission needed: DB/bucket sizes come from the admin_storage_usage RPC.
# Never use a classic token here: it has full access to every project on the account.
# Project ref is ONLY the subdomain id (xxxx), not the full https://xxxx.supabase.co URL
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
